{
  "name": "kirakana",
  "description": "Aplicación web interactiva para practicar y aprender Hiragana y Katakana a través de un sistema de puzzle con opciones múltiples.",
  "type": "module",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "release": "pnpm dlx semantic-release",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/kirakana.app.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/kirakana.app/issues"
  },
  "dependencies": {
    "@astrojs/react": "5.0.0",
    "@astrojs/sitemap": "3.7.1",
    "@fontsource/fredoka": "5.2.10",
    "@fontsource/noto-sans-jp": "5.2.9",
    "@tailwindcss/vite": "4.2.1",
    "astro": "5.18.1",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "5.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "schema-dts": "1.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@biomejs/biome": "2.3.10",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.32.1"
}
