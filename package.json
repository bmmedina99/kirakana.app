{
  "name": "kirakana",
  "description": "Aprende Hiragana (ひらがな) y Katakana (カタカナ) con práctica interactiva de reconocimiento y escucha. Mejora tu lectura de japonés paso a paso.",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "release": "pnpm dlx semantic-release",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/kirakana.app.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/kirakana.app/issues"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/react": "5.0.3",
    "@astrojs/sitemap": "3.7.2",
    "@biomejs/biome": "2.4.11",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro": "6.1.5",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "6.0.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "sharp": "0.34.5"
  },
  "packageManager": "pnpm@10.33.0"
}
