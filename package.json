{
  "name": "kirakana",
  "description": "Aplicación web interactiva para practicar y aprender Hiragana y Katakana a través de un sistema de puzzle con opciones múltiples.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/kirakana.app.git"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.4.1",
    "@fontsource/poppins": "5.2.6",
    "@tailwindcss/vite": "4.1.8",
    "astro": "5.10.1",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "5.0.0",
    "schema-dts": "1.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@biomejs/biome": "2.0.6",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "12.0.2",
    "@types/node": "24.0.7",
    "sharp": "0.34.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.12.4"
}
