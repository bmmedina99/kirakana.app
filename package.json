{
  "name": "kirakana",
  "description": "Aprende Hiragana (ひらがな) y Katakana (カタカナ) con práctica interactiva de reconocimiento y escucha. El método más fácil para empezar japonés desde cero.",
  "type": "module",
  "version": "0.13.2",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "release": "pnpm dlx semantic-release",
    "preview": "astro preview --port=5000",
    "fmt": "biome format --write .",
    "lint": "biome check && biome lint --write .",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/kirakana.app.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/kirakana.app/issues"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.9",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.11",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
