---
import { Font } from 'astro:assets'
import { Schema } from 'astro-seo-schema'
import { configSite } from '@/site.config'
import globalCSS from '@/styles/global.css?inline'

const schemaBase = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://kirakana.app/#organization',
      name: configSite.title,
      url: configSite.url,
      logo: {
        '@type': 'ImageObject',
        url: 'https://kirakana.app/images/logo-kirakana.webp',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://kirakana.app/#website',
      name: configSite.title,
      url: configSite.url,
      description: configSite.description,
      inLanguage: configSite.lang,
      publisher: {
        '@id': 'https://kirakana.app/#organization',
      },
      about: [
        {
          '@type': 'Thing',
          name: 'Hiragana',
        },
        {
          '@type': 'Thing',
          name: 'Katakana',
        },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://kirakana.app/#app',
      name: configSite.title,
      url: configSite.url,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      description: configSite.description,
      inLanguage: configSite.lang,
      isAccessibleForFree: true,
      educationalUse: ['Learning', 'Practice'],
      teaches: 'Hiragana y Katakana - escritura japoonesa',
      learningResourceType: [
        'Ejercicios interactivos',
        'Aprendizaje autodidacta',
      ],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
      },
      publisher: {
        '@id': 'https://kirakana.app/#organization',
      },
    },
  ],
}

const {
  title,
  description,
  robots = 'index, follow',
  errorPage,
  schema = schemaBase,
} = Astro.props

const siteTitle = `${title} | ${configSite.title}`
const siteURL = new URL(Astro.request.url, Astro.site).toString()
const siteAuthor = configSite.author
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<Font cssVariable="--font-outfit" />
<Font cssVariable="--font-noto-serif-jp" />
<style set:html={globalCSS}></style>

<title>{siteTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteAuthor} />
<meta name="robots" content={robots} />

{
  !errorPage && (
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="bmmedina.dev" />
    <meta property="og:image" content={`${siteURL}images/open-graph.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={siteURL} />
    <meta property="og:type" content="website" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteURL}images/twitter-card.webp`} />
    <meta property="twitter:url" content={siteURL} />
    <meta property="twitter:site" content="@twiter-site" />
    <meta property="twitter:creator" content="@twitter-author" />
  )
}

<meta name="theme-color" content="#faf0e6" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="canonical" href={siteURL} />

<Schema item={schema} />
