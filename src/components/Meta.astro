---
import fontFredoka from '@fontsource/fredoka/files/fredoka-latin-700-normal.woff2?url'
import { Schema } from 'astro-seo-schema'
import { configSite } from '@/site.config'
import globalCSS from '@/styles/global.css?url'

const canonicalURL = new URL(Astro.request.url, Astro.site).toString()
const { title } = Astro.props
const siteTitle = `${title} | ${configSite.title}`
const description = configSite.description
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link
  rel="preload"
  href={fontFredoka}
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<style>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 3rem;
  }
  body {
    display: grid;
    background-color: oklch(98.7% 0.022 95.277);
    min-height: 100dvh;
    font-family: "Poppins", sans-serif;
    color: oklch(26.9% 0 0);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  @font-face {
    font-family: "Noto Sans JP";
    font-style: normal;
    font-display: swap;
    font-weight: 400;
    src: url(@fontsource/noto-sans-jp/files/noto-sans-jp-japanese-400-normal.woff2)
      format("woff2");
  }
  @font-face {
    font-family: "Noto Sans JP";
    font-style: normal;
    font-display: swap;
    font-weight: 500;
    src: url(@fontsource/noto-sans-jp/files/noto-sans-jp-japanese-500-normal.woff2)
      format("woff2");
  }
  @font-face {
    font-family: "Fredoka";
    font-style: normal;
    font-display: swap;
    font-weight: 600;
    src: url(@fontsource/fredoka/files/fredoka-latin-600-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Fredoka";
    font-style: normal;
    font-display: swap;
    font-weight: 700;
    src: url(@fontsource/fredoka/files/fredoka-latin-700-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>

<link
  rel="preload"
  href={globalCSS}
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
/>

<title>{siteTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />
<meta name="author" content={configSite.author} />

<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="bmmedina.dev" />
<meta property="og:image" content=`${canonicalURL}/images/open-graph.webp` />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content="website" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta
  property="twitter:image"
  content=`${canonicalURL}/images/twitter-card.webp`
/>
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:site" content="@twiter-site" />
<meta property="twitter:creator" content="@twitter-author" />

<meta name="theme-color" content="#003014" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={canonicalURL} />

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: configSite.author,
    url: canonicalURL,
    description: description,
  }}
/>
