---
import { Font } from 'astro:assets'
import { Schema } from 'astro-seo-schema'
import { configSite } from '@/site.config'
import globalCSS from '@/styles/global.css?inline'

const { title, description } = Astro.props
const siteTitle = `${title} | ${configSite.title}`
const siteURL = new URL(Astro.request.url, Astro.site).toString()
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<Font cssVariable="--font-outfit" />
<Font cssVariable="--font-noto-serif-jp" />
<style set:html={globalCSS}></style>

<title>{siteTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="author" content={configSite.author} />

<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="bmmedina.dev" />
<meta property="og:image" content=`${siteURL}/images/open-graph.webp` />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={siteURL} />
<meta property="og:type" content="website" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content=`${siteURL}/images/twitter-card.webp` />
<meta property="twitter:url" content={siteURL} />
<meta property="twitter:site" content="@twiter-site" />
<meta property="twitter:creator" content="@twitter-author" />

<meta name="theme-color" content="#003014" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="siteURL" href={siteURL} />

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: configSite.author,
    url: siteURL,
    description: description,
  }}
/>
