---
import { Font } from 'astro:assets'
import { Schema } from 'astro-seo-schema'
import globalCSS from '@/assets/styles/global.css?inline'
import { buildJsonLd } from '@/lib/schema'
import { configSite } from '@/lib/site.config'

const {
  title,
  description,
  canonical = Astro.url.href,
  schemas = [],
  breadcrumbs,
  ogImage = '/assets/images/kirakana-social.jpg',
  noindex = false,
} = Astro.props

const schemaJsonLd = buildJsonLd({
  url: canonical,
  title,
  description,
  schemas,
  breadcrumbs,
})

const siteTitle = `${title} | ${configSite.name}`
const ogImageUrl = new URL(ogImage, configSite.url).toString()
const ogImageAlt = 'Kirakana y los kanas japoneses Hiragana y Katakana.'
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={`${canonical}/`} />

<meta name="author" content={configSite.author} />
<meta name="theme-color" content="#faf0e6" />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<Font cssVariable="--font-outfit" />
<Font cssVariable="--font-noto-serif-jp" />
<style set:html={globalCSS}></style>

<meta property="og:url" content={canonical} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={configSite.name} />
<meta property="og:locale" content={configSite.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@bmmedina99" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="icon" type="image/png" href="/favicon-96x96.png?v=260904" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=260904" />
<link rel="shortcut icon" href="/favicon.ico?v=260904" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=260904" />
<meta name="apple-mobile-web-app-title" content="KiraKana" />
<link rel="manifest" href="/site.webmanifest?v=260904" />

<Schema item={schemaJsonLd as any} />
