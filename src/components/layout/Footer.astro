---
import packageJson from '../../../package.json'
import Icon from '../ui/Icon'

const version = packageJson.version
---

<footer id="footer-content" class="w-full pt-8 pb-10 bg-linen-50">
  <section
    class="container flex flex-col items-center gap-6 mx-auto text-center"
  >
    <h2 class="flex items-center gap-2 text-3xl font-semibold">
      <Icon name="cherry" className="text-ochre-200 size-8" />
      <span>KiraKana</span>
    </h2>
    <figure class="flex flex-col items-center gap-2">
      <blockquote
        lang="ja"
        class="text-xl font-semibold tracking-widest font-japanese"
        aria-label="Cita en japonés"
      >
        <p class="text-ochre-200">できるまでやってみよう</p>
      </blockquote>
      <figcaption class="text-sm italic text-copper-200">«Inténtalo hasta lograrlo»</figcaption>
    </figure>
    <span class="w-12 h-px bg-copper-200" aria-hidden="true"></span>
    <address
      class="flex flex-col flex-wrap items-center justify-center gap-1 text-xs not-italic"
    >
      <a
        href={`https://github.com/bmmedina99/kirakana.app/releases/tag/v${version}`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold hover:underline text-copper-200"
      >
        KiraKana v{version}
      </a>
      <span>
        Diseñado y desarrollado por{" "}
        <a
          href="https://bmmedina.dev"
          target="_blank"
          rel="noopener noreferrer author"
          class="font-semibold text-copper-200 hover:underline"
          aria-label="Portfolio de bmmedina, desarrollador de KiraKana"
        >
          @bmmedina99
        </a>
      </span>
      <span>
        ¿KiraKana te ha sido útil?{" "}
        <a
          href="https://ko-fi.com/bmmedina99"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-copper-200 hover:underline"
        >
          Apóyanos voluntariamente
        </a>
      </span>
    </address>
  </section>
</footer>
