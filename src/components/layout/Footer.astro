---
import Icon from '../ui/Icon.astro'
---

<footer class="px-4 py-8 text-center border-t border-yellow-400">
  <section
    class="container flex flex-col items-center justify-between gap-2 mx-auto md:flex-row"
  >
    <div class="flex items-center mb-4 space-x-2 md:mb-0">
      <Icon name="cherry" class="text-red-700" />
      <span class="font-semibold font-heading">KiraKana</span>
    </div>
    <p>
      <span class="font-semibold font-heading">KiraKana</span>
      &copy; {new Date().getFullYear()} - Desarrollado y diseñado por
      <a
        href="https://bmmedina.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-transparent bg-clip-text bg-linear-to-r from-red-700 to-cyan-700"
      >
        @bmmedina99
      </a>
    </p>
  </section>
</footer>
