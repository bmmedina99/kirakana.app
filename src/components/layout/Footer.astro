---
import Icon from '../ui/Icon.astro'
---

<footer class="flex items-center px-4 py-8 border-t border-yellow-300">
  <div class="container mx-auto">
    <div class="flex flex-col items-center justify-between md:flex-row">
      <div class="flex items-center mb-4 space-x-2 md:mb-0">
        <div class="flex items-center justify-center rounded">
          <Icon name="cherry" class="text-red-600" />
        </div>
        <span class="font-semibold font-heading">KiraKana</span>
      </div>
      <p>
        KiraKana &copy; {new Date().getFullYear()} | Desarrollado y diseñado por
        <a
          href="https://bmmedina.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="underline transition-colors hover:text-cyan-700"
        >
          @bmmedina99
        </a>
      </p>
    </div>
  </div>
</footer>
