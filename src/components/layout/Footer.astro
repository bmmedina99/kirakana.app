---
import { navLinks } from '@/lib/navigation'
import packageJson from '../../../package.json'
import Icon from '../ui/Icon.astro'

const pathname = Astro.url.pathname
const version = packageJson.version
---

<footer id="footer-content" class="w-full pt-8 pb-10 bg-linen-50">
  <section
    class="container flex flex-col items-center gap-6 mx-auto text-center"
  >
    <h2 class="flex items-center gap-2 text-3xl font-semibold">
      <Icon name="cherry" class="text-ochre-200 size-8" />
      <span>KiraKana</span>
    </h2>
    <figure class="flex flex-col items-center gap-2">
      <blockquote
        lang="ja"
        class="text-xl font-semibold tracking-widest font-japanese"
        aria-label="Cita en japonés"
      >
        <p class="text-ochre-200">できるまでやってみよう</p>
      </blockquote>
      <figcaption class="text-sm italic">«Inténtalo hasta lograrlo»</figcaption>
    </figure>
    <span class="w-12 h-px bg-ochre-200" aria-hidden="true"></span>
    <nav
      class="flex flex-wrap justify-center text-sm gap-x-4 gap-y-2"
      aria-label="Navegación secundaria"
    >
      {
        navLinks.map((link) => {
          const isActive =
            link.href === "/"
              ? pathname === "/"
              : pathname === link.href || pathname.startsWith(`${link.href}`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "border-b-2 transition-colors",
                isActive
                  ? "border-ochre-200 text-ochre-200"
                  : "hover:border-ochre-100 border-transparent",
              ]}
            >
              {link.title}
            </a>
          );
        })
      }
    </nav>
    <address
      class="flex flex-col flex-wrap items-center justify-center gap-1 text-xs not-italic"
    >
      <a
        href="https://github.com/bmmedina99/kirakana.app"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold hover:underline"
      >
        [ v{version} ]
      </a>
      <a
        href="https://ko-fi.com/bmmedina99"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold transition-colors text-cyan-900 hover:text-ochre-200"
      >
        Apoyar a KiraKana
      </a>
      <div>
        <span>{new Date().getFullYear()} KiraKana.</span>
        <span>Diseñado y desarrollado por</span>
        <a
          href="https://bmmedina.dev"
          target="_blank"
          rel="noopener noreferrer author"
          class="font-semibold transition-colors text-cyan-900 hover:text-ochre-200"
          aria-label="Portfolio de bmmedina, desarrollador de KiraKana"
        >
          @bmmedina99
        </a>
      </div>
    </address>
  </section>
</footer>
