---
const { labelledby } = Astro.props
---

<section class="max-w-6xl mx-auto" aria-labelledby={labelledby}>
  <header class="max-w-3xl mx-auto mb-12 space-y-4 leading-relaxed text-center">
    <h1 id={labelledby} class="text-4xl font-semibold text-balance sm:text-5xl">
      <slot name="title" />
    </h1>
    <p class="text-lg text-pretty text-copper-100">
      <slot name="description" />
    </p>
  </header>
  <slot />
</section>
