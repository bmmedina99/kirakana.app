---
import { Image } from 'astro:assets'
import LogoKirakana from '@/assets/logo-kirakana.png'
import { configSite } from '@/site.config'
import Navigation from '../ui/Navigation.astro'
---

<header class="flex items-center justify-center h-24 px-4 my-4 bg-linen-100">
  <div class="container flex items-center justify-between mx-auto">
    <a
      href="/"
      aria-label={configSite.name}
      class="flex items-center text-3xl font-semibold md:text-5xl"
    >
      <Image
        src={LogoKirakana}
        alt="Logo de KiraKana"
        class="aspect-square"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        densities={[1, 2]}
        width={96}
        height={96}
      />
      <span class="-translate-x-6" aria-hidden="true">
        <small class="sr-only">K</small>iraKana
      </span>
    </a>
    <Navigation />
  </div>
</header>
