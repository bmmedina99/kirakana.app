---
import { Image } from 'astro:assets'
import LogoKirakana from '@/assets/images/logo-kirakana.avif'
import Navigation from '../ui/Navigation.astro'
---

<header class="flex items-center justify-center h-24 px-4 my-6">
  <section class="container flex items-center justify-between mx-auto">
    <a
      href="/"
      aria-label="Página principal de KiraKana"
      class="flex items-center text-3xl font-semibold md:text-5xl"
    >
      <Image
        src={LogoKirakana}
        alt="Logo de KiraKana"
        class="aspect-square"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        densities={[1, 2]}
        width={96}
        height={96}
        format="avif"
      />
      <p class="-translate-x-6" aria-hidden="true">
        <span class="sr-only">K</span>iraKana
      </p>
    </a>
    <Navigation />
  </section>
</header>
