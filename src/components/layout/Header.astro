---
import { configSite, navLinks } from '@/site.config'
import Icon from '../ui/Icon.astro'
---

<header
  class="sticky z-50 flex items-center border-b 0 border-slate-800/50 backdrop-blur-sm bg-slate-900/50"
>
  <div class="container px-4 py-4 mx-auto">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <div
          class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-r from-orange-pantone to-medium-slate-blue"
        >
          <Icon name="star" class="text-yellow-300" />
        </div>
        <span class="text-xl font-bold text-white">{configSite.title}</span>
      </div>
      <nav class="items-center hidden space-x-6 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="transition-colors text-slate-300 hover:text-orange-400"
            >
              {link.title}
            </a>
          ))
        }
      </nav>
      <a
        href="https://github.com/bmmedina99/kirakana.app"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center px-4 py-2 text-orange-400 transition-colors bg-transparent border-2 rounded-lg border-orange-pantone hover:bg-orange-pantone hover:text-white"
      >
        <Icon name="github" class="mr-2" />
        GitHub
      </a>
    </div>
  </div>
</header>
