---
import { configSite } from '@/site.config'
import Icon from '../ui/Icon.astro'
import Navigation from '../ui/Navigation.astro'
---

<header
  class="sticky top-0 z-50 px-4 py-8 border-b border-yellow-400 select-none backdrop-blur-lg"
>
  <section class="container flex items-center justify-between mx-auto">
    <div class="flex items-center gap-2 text-2xl font-semibold font-heading">
      <Icon name="cherry" class="text-red-700" />
      {configSite.title}
    </div>
    <Navigation />
    <a
      href="https://github.com/bmmedina99/kirakana.app"
      target="_blank"
      rel="noopener noreferrer"
      class="items-center hidden px-4 py-2 transition-colors border-2 rounded-lg md:flex hover:bg-yellow-400"
    >
      <Icon name="github" class="mr-2" />
      GitHub
    </a>
  </section>
</header>
