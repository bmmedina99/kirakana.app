---
import { configSite, navLinks } from '@/site.config'
import Icon from '../ui/Icon.astro'
---

<header
  class="container sticky z-50 flex items-center justify-between p-4 mx-auto border-b border-yellow-300 backdrop-blur-lg"
>
  <section
    class="flex items-center gap-2 text-xl font-semibold uppercase font-heading"
  >
    <Icon name="cherry" class="text-red-700"/>
    {configSite.title}
  </section>
  <nav class="hidden md:block">
    <ul class="flex items-center gap-6">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="p-2 text-lg transition-colors rounded-md hover:bg-yellow-300"
            >
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a
    href="https://github.com/bmmedina99/kirakana.app"
    target="_blank"
    rel="noopener noreferrer"
    class="items-center hidden px-4 py-2 transition-colors border-2 rounded-lg md:flex hover:bg-yellow-300"
  >
    <Icon name="github" class="mr-2" />
    GitHub
  </a>
  <button
    type="button"
    class="flex p-2 transition-colors border-2 rounded-md md:hidden border-neutral-800 hover:bg-yellow-300"
  >
    <span class="sr-only">Menu</span>
    <Icon name="menu" />
  </button>
</header>
