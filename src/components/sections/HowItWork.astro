---
import { WORK_CARDS } from "@/libs/constants/workcards";
import Card from "../ui/Card.astro";
---

<section
  id="como-funciona"
  class="relative w-full py-16 overflow-hidden md:py-24 bg-linear-to-br from-white via-amber-50/30 to-red-50/20"
>
  <div class="container relative px-4 mx-auto md:px-6">
    <div
      class="flex flex-col items-center justify-center mb-16 space-y-4 text-center"
    >
      <h2 class="text-3xl font-bold font-heading md:text-5xl">
        Cómo
        <span
          class="text-transparent bg-clip-text bg-linear-to-r from-red-400 to-sky-400"
        >
          KiraKana
        </span>
        te ayuda a aprender
      </h2>
      <p class="max-w-2xl text-pretty md:text-xl">
        El enfoque de KiraKana combina aprendizaje visual, práctica interactiva
        y seguimiento del progreso para ayudarte a dominar los silabarios
        japoneses de manera simple, divertida y efectiva.
      </p>
    </div>
    <div
      class="grid grid-cols-1 gap-8 text-center md:grid-cols-2 lg:grid-cols-4 text-pretty"
    >
      {
        WORK_CARDS.map(({ icon, color, title, description }) => (
          <Card
            icon={icon}
            color={color}
            title={title}
            description={description}
          />
        ))
      }
    </div>
  </div>
</section>
