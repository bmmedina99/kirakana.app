---
import Icon from '../ui/Icon.astro'

const reasons = [
  {
    icon: 'dont-disturb',
    title: 'Aprende japonés sin anuncios ni distracciones',
    description:
      'Practica hiragana y katakana sin interrupciones. En KiraKana priorizamos tu concentración para que aprendas japonés de forma efectiva.',
  },
  {
    icon: 'free-content',
    title: 'Aprende hiragana y katakana gratis, sin suscripciones',
    description:
      'Accede a ejercicios interactivos de japonés sin pagar. KiraKana es una plataforma gratuita para aprender desde cero.',
  },
  {
    icon: 'dont-stress',
    title: 'Aprende japonés a tu ritmo, sin presión',
    description:
      'Estudia hiragana y katakana sin estrés. Sin temporizadores ni presión, solo aprendizaje progresivo y efectivo.',
  },
]
---

<section class="relative px-4 py-32">
  <div
    class="container grid items-center gap-16 px-6 mx-auto md:px-12 lg:grid-cols-2"
  >
    <div>
      <h2
        class="mb-4 text-3xl font-semibold leading-tight tracking-tight lg:text-5xl text-balance"
      >
        ¿Por qué usar KiraKana para aprender japonés?
      </h2>
      <p class="mb-8 text-xl lg:text-2xl text-copper-200 text-pretty">
        La mejor forma de aprender japonés:
        <strong class="text-ochre-200">Hiragana</strong>
        y <strong class="text-cyan-900">Katakana</strong> sin estrés.
      </p>
      <ul class="space-y-8">
        {
          reasons.map((reason) => (
            <li class="flex gap-6">
              <div class="flex items-center justify-center rounded-full size-12 shrink-0 bg-charcoal-100">
                <Icon name={reason.icon} class="text-linen-150" />
              </div>
              <div>
                <h3 class="mb-1 text-lg font-bold text-charcoal-100 md:text-xl">
                  {reason.title}
                </h3>
                <p class="text-copper-100 md:text-lg text-pretty">
                  {reason.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <figure
      class="relative flex items-center justify-center bg-linen-150 rounded-4xl aspect-square"
      aria-hidden="true"
    >
      <div class="text-center">
        <span
          class="block mb-4 text-6xl font-japanese lg:text-9xl text-charcoal-100"
        >
          静
        </span>
        <p class="text-lg italic lg:text-2xl text-copper-200 text-pretty">
          "Shizuka" - «Aprender en calma»
        </p>
      </div>
      <div
        class="absolute inset-0 m-4 border-2 border-charcoal-100 rounded-2xl"
      >
        <div class="absolute inset-0 m-2 border rounded-lg border-copper-200">
        </div>
      </div>
    </figure>
  </div>
</section>
