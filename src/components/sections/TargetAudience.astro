---
const audiences = [
  {
    accent: 'Para principiantes',
    title: 'Aprende japonés desde cero',
    icon: '初',
    description:
      'Si nunca has estudiado japonés, empieza con lo esencial. Aprende hiragana y katakana paso a paso con ejercicios simples y sin estrés.',
  },
  {
    accent: 'Para viajeros',
    title: 'Aprende japonés para viajar',
    icon: '旅',
    description:
      'Aprende a leer menús, carteles y estaciones en Japón. Domina hiragana y katakana para moverte con confianza en tu viaje.',
  },
  {
    accent: 'Para una experiencia zen',
    title: 'Aprende japonés a tu ritmo',
    icon: '静',
    description:
      'Para quienes buscan una experiencia de aprendizaje relajada. Estudia hiragana y katakana a tu ritmo, sin estrés ni distracciones.',
  },
]
---

<section class="relative px-4 py-32 bg-slate-550 text-mauve-50">
  <div class="container mx-auto">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest">
        Aprende japonés según tu objetivo
      </p>
      <h2 class="mt-6 text-3xl font-semibold lg:text-5xl">
        ¿Para quién es KiraKana?
      </h2>
      <p class="mt-4 max-w-2xl leading-7 text-xl lg:text-2xl text-pretty">
        <strong class="text-rose-200">KiraKana</strong> está diseñada para personas
        que quieran aprender
        <strong class="text-rose-200">hiragana</strong>
        y <strong class="text-rose-200">katakana</strong>
        de forma visual, tranquila y accesible, ya sea para empezar desde cero, preparar
        un viaje o estudiar japonés sin presión.
      </p>
    </div>
    <div class="mt-10 grid gap-12 md:grid-cols-2 xl:grid-cols-3">
      {
        audiences.map((audience) => (
          <article class="group relative flex h-full flex-col rounded-3xl border border-rose-200 p-6 transition duration-300 hover:-translate-y-1 shadow-lg">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="absolute -top-5 bg-rose-200 px-4 py-2 rounded-full text-slate-550 text-sm font-medium">
                  {audience.accent}
                </p>
                <h3 class="mt-3 text-2xl font-semibold leading-tight">
                  {audience.title}
                </h3>
              </div>
              <span
                class="shrink-0 rounded-2xl p-4 text-3xl leading-none text-slate-550 bg-rose-200 select-none md:absolute md:-bottom-5 md:-right-5 font-japanese"
                aria-hidden="true"
              >
                {audience.icon}
              </span>
            </div>

            <p class="mt-5 leading-7 text-pretty">{audience.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
