---
import type { Fragment } from 'react'
import Icon from '../ui/Icon.astro'
---

<section class="w-full border-yellow-400 border-y">
  <div class="max-w-6xl px-4 py-8 mx-auto">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 md:gap-8">
      <div class="flex flex-col items-center space-y-3 text-center">
        <div class="flex items-center justify-center w-12 h-12">
          <Icon name="learn" class="size-full text-red-500" />
        </div>
        <h3 class="text-2xl font-bold text-gray-900">92 caracteres</h3>
        <div class="space-y-1 text-sm text-gray-600">
          <p>46 Hiragana + 46 Katakana</p>
          <p>Domina ambos silabarios</p>
        </div>
      </div>

      <div class="flex flex-col items-center space-y-3 text-center">
        <div class="flex items-center justify-center w-12 h-12">
          <Icon name="lightbulb" class="size-full text-teal-500" />
        </div>
        <h3 class="text-2xl font-bold text-gray-900">Aprendizaje activo</h3>
        <div class="space-y-1 text-sm text-gray-600">
          <p>Reconocimiento visual</p>
          <p>Práctica por repetición</p>
        </div>
      </div>

      <div class="flex flex-col items-center space-y-3 text-center">
        <div class="flex items-center justify-center w-12 h-12">
          <Icon name="padlock" class="size-full text-purple-500" />
        </div>
        <h3 class="text-2xl font-bold text-gray-900">Privacidad total</h3>
        <div class="space-y-1 text-sm text-gray-600">
          <p>Sin registro ni cuentas</p>
          <p>Sin datos personales</p>
        </div>
      </div>

      <div class="flex flex-col items-center space-y-3 text-center">
        <div class="flex items-center justify-center w-12 h-12">
          <Icon name="save" class="size-full text-blue-500" />
        </div>
        <h3 class="text-2xl font-bold text-gray-900">Progreso guardado</h3>
        <div class="space-y-1 text-sm text-gray-600">
          <p>Almacenado localmente</p>
          <p>Avance siempre disponible</p>
        </div>
      </div>
    </div>
  </div>
</section>
