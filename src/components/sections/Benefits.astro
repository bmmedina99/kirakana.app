---
import Icon from '../ui/Icon.astro'
---

<ul
  class="container grid w-full grid-cols-1 gap-12 px-4 pt-6 pb-12 mx-auto md:grid-cols-2 lg:grid-cols-4 lg:gap-8"
>
  <li class="flex flex-col items-center space-y-3 text-center">
    <div class="flex items-center justify-center size-12" aria-hidden="true">
      <Icon name="learn" class="text-ochre-100 size-full" />
    </div>
    <h3 class="mb-4 text-2xl font-semibold">92 caracteres</h3>
    <p class="space-y-1 text-sm text-copper-100">
      46 Hiragana + 46 Katakana<br />
      Domina ambos silabarios
    </p>
  </li>
  <li class="flex flex-col items-center space-y-3 text-center">
    <div class="flex items-center justify-center size-12" aria-hidden="true">
      <Icon name="lightbulb" class="text-ochre-100 size-full" />
    </div>
    <h3 class="mb-4 text-2xl font-semibold">Aprendizaje activo</h3>
    <p class="space-y-1 text-sm text-copper-100">
      Reconocimiento visual<br />
      Práctica por repetición
    </p>
  </li>
  <li class="flex flex-col items-center space-y-3 text-center">
    <div class="flex items-center justify-center size-12" aria-hidden="true">
      <Icon name="padlock" class="text-ochre-100 size-full" />
    </div>
    <h3 class="mb-4 text-2xl font-semibold">Privacidad total</h3>
    <p class="space-y-1 text-sm text-copper-100">
      Sin registro ni cuentas<br />
      Sin datos personales
    </p>
  </li>
  <li class="flex flex-col items-center space-y-3 text-center">
    <div class="flex items-center justify-center size-12" aria-hidden="true">
      <Icon name="save" class="text-ochre-100 size-full" />
    </div>
    <h3 class="mb-4 text-2xl font-semibold">Progreso guardado</h3>
    <p class="space-y-1 text-sm text-copper-100">
      Almacenado localmente<br />
      Avance siempre disponible
    </p>
  </li>
</ul>
