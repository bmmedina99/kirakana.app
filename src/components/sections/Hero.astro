---
import { configSite } from '@/site.config'
---

<section class="px-4 py-32">
  <div class="container mx-auto text-center">
    <h1 class="mb-6 text-5xl font-bold leading-tight text-white md:text-7xl">
      {configSite.title}
      <span
        class="block text-transparent bg-clip-text bg-gradient-to-t from-orange-pantone to-medium-slate-blue"
      >
        En desarrollo
      </span>
    </h1>
    <p class="max-w-3xl mx-auto mb-8 text-xl leading-relaxed text-slate-300">
      Aplicación interactiva para practicar y aprender <strong class="text-orange-300">Hiragana</strong> <span class="text-sm">(ひらがな)</span> y <strong class="text-purple-300">Katakana</strong> <span class="text-sm">(カタカナ)</span> a través de un sistema de puzzle con opciones múltiples.
    </p>
  </div>
</section>
