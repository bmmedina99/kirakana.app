---
const { name, width = 24, height = 24, class: classes } = Astro.props
---

<svg
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="2"
  aria-hidden="true"
  class:list={[{ [classes]: classes }]}
>
  <use href={`/svg/sprite.svg#${name}`}></use>
</svg>
