---
import { navLinks } from '@/site.config'
import Icon from './Icon.astro'

const route = Astro.routePattern
---

<nav class="hidden md:block">
  <ul class="flex items-center gap-6">
    {
      navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`${route === link.href ? "border-ochre-200 text-ochre-200" : "hover:border-ochre-200 border-transparent"} border-b-2 py-1.5 px-3 text-lg transition-colors`}
          >
            {link.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<div id="menu-container" class="relative md:hidden">
  <input id="mobile-menu" type="checkbox" class="hidden peer" />
  <label
    for="mobile-menu"
    class="relative flex p-2 transition-colors border-2 rounded-md cursor-pointer size-10 border-neutral-800 hover:bg-yellow-400"
  >
    <span class="sr-only">Abrir menú de navegación</span>
  </label>
  <Icon
    name="menu"
    class="absolute pointer-events-none top-2 left-2 peer-checked:hidden"
  />
  <Icon
    name="close"
    class="absolute hidden pointer-events-none top-2 left-2 peer-checked:block"
  />
  <div
    class="absolute right-0 invisible w-48 mt-2 transition-all duration-200 transform scale-95 border-2 border-yellow-400 rounded-md opacity-0 bg-yellow-50 peer-checked:opacity-100 peer-checked:visible peer-checked:scale-100 drop-shadow-2xl"
  >
    <nav class="p-2">
      <ul class="space-y-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block p-3 text-lg transition-colors rounded-md hover:bg-yellow-400/80"
              >
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="pt-2 mt-2 border-t border-yellow-400">
        <a
          href="https://github.com/bmmedina99/kirakana.app"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-3 text-lg transition-colors rounded-md hover:bg-yellow-400"
        >
          <Icon name="github" class="mr-2" />
          GitHub
        </a>
      </div>
    </nav>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuContainer = document.querySelector("#menu-container");
    const menuToggle = document.querySelector(
      "#mobile-menu",
    ) as HTMLInputElement;

    document.addEventListener("click", (e) => {
      if (!menuContainer?.contains(e.target as Node) && menuToggle)
        menuToggle.checked = false;
    });
  });
</script>
