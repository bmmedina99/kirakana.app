---
import { navLinks } from '@/site.config'
import Icon from './Icon.astro'

const pathname = Astro.url.pathname
---

<nav
  class="z-10 items-center hidden gap-6 md:flex"
  aria-label="Navegación principal"
>
  {
    navLinks.slice(1).map((link) => {
      const isActive =
        link.href === "/"
          ? pathname === "/"
          : pathname === link.href || pathname.startsWith(`${link.href}`);
      return (
        <a
          href={link.href}
          aria-current={isActive ? "page" : undefined}
          class={`${isActive ? "border-cyan-900 text-cyan-900" : "hover:border-charcoal-100 border-transparent"} border-b-2 py-1.5 px-3 text-lg transition-colors`}
        >
          {link.title}
        </a>
      );
    })
  }
</nav>
<div id="menu-container" class="relative md:hidden">
  <input
    id="mobile-menu"
    type="checkbox"
    class="hidden peer"
    aria-hidden="true"
  />
  <label
    for="mobile-menu"
    class="relative flex items-center justify-center transition-colors border-2 rounded-md cursor-pointer size-10 border-sun-100 text-copper-100"
  >
    <span class="sr-only">Abrir menú de navegación</span>
    <Icon name="menu" class="inset-0 pointer-events-none peer-checked:hidden" />
    <Icon name="close" class="hidden pointer-events-none peer-checked:block" />
  </label>
  <nav
    id="mobile-nav"
    class="absolute right-0 z-10 w-48 mt-2 space-y-2 text-center transition-opacity border-2 rounded-md opacity-0 border-sun-100 bg-mauve-50/40 peer-checked:opacity-100 backdrop-blur-sm"
    aria-label="Navegación móvil"
  >
    {
      navLinks.map((link) => {
        const isActive =
          pathname === link.href || pathname.startsWith(`${link.href}/`);
        return (
          <a
            href={link.href}
            aria-current={isActive ? "page" : undefined}
            class={`${isActive ? "border-charcoal-100 text-charcoal-100" : "hover:border-charcoal-100 border-transparent"} block border-b-2 py-1.5 px-3 text-lg transition-colors max-w-24 mx-auto`}
          >
            {link.title}
          </a>
        );
      })
    }
  </nav>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuContainer = document.querySelector("#menu-container");
    const menuToggle = document.querySelector(
      "#mobile-menu",
    ) as HTMLInputElement;

    document.addEventListener("click", (e) => {
      if (!menuContainer?.contains(e.target as Node) && menuToggle)
        menuToggle.checked = false;
    });
  });
</script>
