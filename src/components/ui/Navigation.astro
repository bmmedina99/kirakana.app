---
import { navLinks } from '@/lib/navigation'
import Icon from './Icon'

const pathname = Astro.url.pathname
const activeColorClasses = pathname.includes('hiragana')
  ? 'border-ochre-200 text-ochre-200'
  : pathname.includes('katakana')
    ? 'border-cyan-900 text-cyan-900'
    : 'border-copper-200 text-copper-200'
---

<nav
  class="z-10 items-center hidden gap-6 md:flex"
  aria-label="Navegación principal"
>
  {
    navLinks.slice(1).map((link) => {
      const isActive = link.href === "/"
          ? pathname === "/"
          : pathname === link.href || pathname.startsWith(`${link.href}`);
      return (
        <a
          href={link.href}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'border-b-2 py-1.5 px-3 text-lg transition-colors',
            isActive
              ? activeColorClasses
              : 'hover:border-charcoal-100 border-transparent',
          ]}
        >
          {link.title}
        </a>
      )
    })
  }
</nav>
<div id="menu-container" class="relative md:hidden">
  <input
    id="mobile-menu"
    type="checkbox"
    class="hidden peer"
    autocomplete="off"
    aria-hidden="true"
  />
  <label
    for="mobile-menu"
    class="relative flex items-center justify-center transition-colors border-2 rounded-md cursor-pointer size-10 border-copper-100 text-charcoal-100"
  >
    <span class="sr-only">Abrir menú de navegación</span>
    <Icon name="menu" className="inset-0 pointer-events-none peer-checked:hidden" />
    <Icon name="close" className="hidden pointer-events-none peer-checked:block" />
  </label>
  <nav
    id="mobile-nav"
    class="absolute right-0 z-10 w-36 mt-2 space-y-2 text-center transition-opacity border-2 rounded-md opacity-0 border-copper-100 bg-mauve-50 peer-checked:opacity-100"
    aria-label="Navegación móvil"
  >
    {
      navLinks.map((link) => {
        const isActive = link.href === "/"
          ? pathname === "/"
          : pathname === link.href || pathname.startsWith(`${link.href}`);
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'block border-b-2 py-1.5 px-3 text-lg transition-colors max-w-24 mx-auto',
              isActive
                ? activeColorClasses
                : 'border-transparent',
            ]}
          >
            {link.title}
          </a>
        )
      })
    }
  </nav>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuContainer = document.querySelector("#menu-container");
    const menuToggle = document.querySelector(
      "#mobile-menu",
    ) as HTMLInputElement;

    document.addEventListener("click", (e) => {
      if (!menuContainer?.contains(e.target as Node) && menuToggle)
        menuToggle.checked = false;
    });
  });
</script>
