---
import Icon from './Icon.astro'

const { icon, color, title, description } = Astro.props
---

<div
  class="p-6 space-y-2 transition-all border rounded-lg bg-amber-50 border-amber-300 group hover:shadow-sm hover:shadow-amber-300"
>
  <div
    class={`card-header size-16 rounded-2xl transition-transform bg-linear-to-br group-hover:scale-150 group-hover:-translate-y-5 ${color.background}`}
  >
    <Icon name={icon} class={color.text} width="32" height="32" />
  </div>
  <h3 class={`text-xl font-bold font-title ${color.text}`}>
    {title}
  </h3>
  <p class="text-sm text-center">
    {description}
  </p>
</div>
