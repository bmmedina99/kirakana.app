---
import { Image } from 'astro:assets'
import Icon from './Icon'

const {
  id,
  stepNumber,
  stepLabel,
  badgeClass,
  title,
  description,
  bullets,
  image,
  imageAlt,
  imageFirst = false,
} = Astro.props
---

<div {id} class="grid items-center gap-20 pt-12 mb-32 md:grid-cols-2">
  <div class:list={[imageFirst ? "order-2 md:order-1" : "order-2 md:order-2"]}>
    <Image
      src={image}
      class="object-cover rounded-md shadow-sm bg-linen-150 md:rounded-2xl shadow-linen-150 aspect-video"
      alt={imageAlt}
      width={1280}
      height={720}
      widths={[345, 725, 1280]}
      sizes="(max-width: 768px) calc(100vw - 2rem), (max-width: 1280px) 585px, 50vw"
      format="avif"
    />
  </div>
  <div class:list={[imageFirst ? "order-1 md:order-2" : "order-1 md:order-1"]}>
    <span
      class={`p-4 text-sm font-semibold tracking-widest uppercase rounded-2xl ${badgeClass}`}
      aria-hidden="true"
    >
      {stepLabel}
    </span>
    <h3 class="mt-8 mb-6 text-3xl font-semibold text-balance">
      <span class="sr-only">Paso {stepNumber}: </span>
      {title}
    </h3>
    <p class="mb-6 text-lg leading-relaxed text-copper-100 text-pretty">
      {description}
    </p>
    <ul class="space-y-4 text-copper-100">
      {
        bullets.map((bullet: string) => (
          <li class="flex items-center gap-3">
            <Icon name="check" className="text-charcoal-100" aria-hidden="true" />
            {bullet}
          </li>
        ))
      }
    </ul>
  </div>
</div>
