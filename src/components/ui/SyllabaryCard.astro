---
import type { Syllabary } from '@/features/data/syllabaries'
import Icon from './Icon.astro'

type Props = {
  syllabary: Syllabary
  href: string
  buttonLabel?: string
}

const { syllabary, href, buttonLabel } = Astro.props
---

<article
  class="relative p-6 overflow-hidden transition duration-300 shadow-sm group min-h-90 rounded-xl bg-linen-50 hover:-translate-y-1 hover:shadow-xl"
>
  <div class="flex items-start justify-between gap-4 mb-6">
    <header>
      <span
        class={`text-xl md:text-2xl font-japanese ${syllabary.theme.accentClass}`}
        lang="ja"
        aria-hidden="true"
      >
        {syllabary.japaneseName}
      </span>
      <h2 class="mb-2 text-2xl md:text-4xl text-semibold">
        {syllabary.name}
      </h2>
      <p class="text-sm md:text-lg text-copper-100 text-pretty">
        {syllabary.description}
      </p>
    </header>
    <div
      class={`grid size-16 shrink-0 place-items-center rounded-full ${syllabary.theme.badgeClass}`}
      aria-hidden="true"
    >
      <Icon name={syllabary.iconKana} class="size-8" />
    </div>
  </div>
  <dl
    class="flex items-center justify-between py-4 mb-6 overflow-hidden select-none"
    aria-label={`Vista previa de ${syllabary.name}`}
  >
    {
      syllabary.previewKana.map((item) => (
        <div class="flex flex-col items-center">
          <dt
            class={`mb-2 text-xl md:text-4xl transition-transform group-hover:scale-110 group-hover:animate-wiggle font-japanese ${syllabary.theme.accentClass}`}
            lang="ja"
          >
            {item.kana}
          </dt>
          <dd class="text-sm">{item.romaji}</dd>
        </div>
      ))
    }
  </dl>
  <a
    href={href}
    class={`text-sm uppercase tracking-widest shadow-lg active:shadow-transparent ${syllabary.theme.buttonClass}`}
  >
    {buttonLabel}
  </a>
</article>
