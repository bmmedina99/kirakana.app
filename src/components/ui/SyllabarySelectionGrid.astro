---
import { syllabaries } from '@/features/data/syllabaries'
import SyllabaryCard from './SyllabaryCard.astro'

type Props = {
  getHref: (slug: string) => string
  getButtonLabel?: (name: string) => string
}

const { getHref, getButtonLabel = (name: string) => `${name}` } = Astro.props
---

<div class="grid gap-8 lg:grid-cols-2">
  {
    syllabaries.map((syllabary) => (
      <SyllabaryCard
        syllabary={syllabary}
        href={getHref(syllabary.slug)}
        buttonLabel={getButtonLabel(syllabary.name)}
      />
    ))
  }
</div>
