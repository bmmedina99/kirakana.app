---
import Main from '@/components/layout/Main.astro'
import { type Syllabary, syllabaries } from '@/features/data/syllabaries'
import LearnSyllabaryPage from '@/features/learn/components/LearnSyllabaryPage.astro'
import Layout from '@/layouts/Layout.astro'
import { learnSyllabarySchema } from '@/lib/schema'
import { configSite } from '@/lib/site.config'

type Props = {
  syllabary: Syllabary
}

export function getStaticPaths() {
  return syllabaries.map((syllabary) => ({
    params: {
      syllabary: syllabary.slug,
    },
    props: {
      syllabary,
    },
  }))
}

const { syllabary } = Astro.props

const title = `Aprende ${syllabary.name}: caracteres y pronunciación`
const description = `Aprende ${syllabary.name} por grupos con referencias visuales y pronunciación. Estudia los caracteres japoneses paso a paso y a tu ritmo.`
const canonical = `${configSite.url}/aprender/${syllabary.slug}`
const schemas = learnSyllabarySchema({
  syllabary: syllabary.slug,
  url: canonical,
  title,
  description,
})
---

<Layout {title} {description} {canonical} {schemas}>
  <Main>
    <LearnSyllabaryPage {syllabary} />
  </Main>
</Layout>
