---
import Main from '@/components/layout/Main.astro'
import { syllabaries } from '@/features/data/syllabaries'
import LearnSyllabaryPage from '@/features/learn/components/LearnSyllabaryPage.astro'
import Layout from '@/layouts/Layout.astro'

export function getStaticPaths() {
  return syllabaries.map((syllabary) => ({
    params: {
      syllabary: syllabary.slug,
    },
    props: {
      syllabary,
    },
  }))
}

const { syllabary } = Astro.props

const learnSyllabaryTitle = `Tabla de ${syllabary} - Aprende los 46 caracteres`
const learnSyllabaryDescription = `Aprende los 46 caracteres ${syllabary} con guías visuales, audio y orden de trazos. La forma más clara de empezar a leer japonés desde cero.`
---

<Layout title={learnSyllabaryTitle} description={learnSyllabaryDescription}>
  <Main>
    <LearnSyllabaryPage syllabary={syllabary} />
  </Main>
</Layout>
