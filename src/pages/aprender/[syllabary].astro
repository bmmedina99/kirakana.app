---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
import { HIRAGANA } from '@/lib/data/hiragana'
import { KATAKANA } from '@/lib/data/katakana'
import type { SyllabarySlug } from '@/lib/routes'

export async function getStaticPaths() {
  const syllabaries: SyllabarySlug[] = ['hiragana', 'katakana']
  return syllabaries.map((syllabary) => ({ params: { syllabary } }))
}

const { syllabary } = Astro.params

const learnSyllabaryTitle = `Tabla de ${syllabary} - Aprende los 46 caracteres`
const learnSyllabaryDescription = `Aprende los 46 caracteres ${syllabary} con guías visuales, audio y orden de trazos. La forma más clara de empezar a leer japonés desde cero.`

const KANA = syllabary === 'hiragana' ? HIRAGANA : KATAKANA
---

<Layout title={learnSyllabaryTitle} description={learnSyllabaryDescription}>
  <Main>
    <section
      class="container grid grid-cols-3 px-4 py-8 mx-auto gap-y-4 lg:grid-cols-5 place-items-center"
    >
      {
        KANA.map((caracter) => (
          <div class="flex flex-col items-center justify-center text-center rounded-lg bg-sun-100 size-16">
            <p class="text-2xl font-semibold font-japanese">{caracter.kana}</p>
            <p class="text-sm">{caracter.romaji}</p>
          </div>
        ))
      }
    </section>
  </Main>
</Layout>
