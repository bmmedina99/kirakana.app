---
import Main from '@/components/layout/Main.astro'
import KanaCard from '@/components/ui/KanaCard.astro'
import Section from '@/components/ui/Section.astro'
import Layout from '@/layouts/Layout.astro'
import { createKanaCards } from '@/libs/utils/createKanaCards'

const learnCards = createKanaCards({
  basePath: 'aprender',
  buttonLabel: 'Aprender',
})

const schema = {}
---

<Layout
  title="Aprende el silabario japonés: Hiragana y Katakana"
  description="Domina los silabarios japoneses con lecciones visuales y audio. Elige hiragana o katakana y aprende los 92 caracteres paso a paso, sin registro."
  schema={schema}
>
  <Main>
    <Section heading="learn-heading">
      <Fragment slot="title">
        Aprende los silabarios <span class="text-ochre-200">japoneses</span>
      </Fragment>
      <Fragment slot="description">
        Aprende <span class="font-semibold text-ochre-200">hiragana</span>
        y <span class="font-semibold text-cyan-900">katakana</span> de forma visual
        y progresiva. Elige el silabario japonés que quieres dominar y haz seguimiento
        de tu avance con KiraKana.
      </Fragment>
      <ul class="grid items-start grid-cols-1 gap-12 lg:grid-cols-2">
        {
          learnCards.map((card) => (
            <li>
              <KanaCard {...card} />
            </li>
          ))
        }
      </ul>
    </Section>
  </Main>
</Layout>
