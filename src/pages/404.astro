---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404">
  <main
    class="relative flex items-center justify-center min-h-screen p-4 overflow-hidden"
  >
    <div class="relative z-10 w-full max-w-4xl space-y-12 text-center">
      <p class="text-6xl font-bold leading-none text-transparent sm:text-8xl bg-clip-text bg-gradient-to-t from-orange-pantone to-medium-slate-blue">
        404
      </p>
      <div class="space-y-6">
        <h1 class="text-4xl font-bold text-white sm:text-5xl">
          Página no encontrada
        </h1>
        <p class="max-w-2xl mx-auto text-xl leading-relaxed text-slate-300">
          Lo sentimos, la página que estás buscando no existe o ha sido movida.
          Pero no te preocupes, hay muchas otras cosas increíbles que puedes
          explorar.
        </p>
      </div>
      <div class="flex items-center justify-center">
        <button
          type="button"
          onclick="window.history.back()"
          class="flex gap-4 px-4 py-3 text-black border-0 rounded-md bg-gradient-to-r from-orange-500 to-purple-600 hover:from-orange-600 hover:to-purple-700"
        >
          Volver a la página anterior
        </button>
      </div>
    </div>
  </main>
</Layout>
