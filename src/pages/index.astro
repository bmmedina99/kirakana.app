---
import Main from "@/components/layout/Main.astro";
import Benefits from "@/components/sections/Benefits.astro";
import Cta from "@/components/sections/Cta.astro";
import Features from "@/components/sections/Features.astro";
import Hero from "@/components/sections/Hero.astro";
import HowItWork from "@/components/sections/HowItWork.astro";
import Layout from "@/layouts/Layout.astro";
import { configSite } from "@/site.config";
---

<Layout title="Hiragana & Katakana" description={configSite.description}>
  <a href="#main-content" class="sr-only focus:not-sr-only">
    Ir al contenido principal
  </a>
  <Main class="flex-col">
    <Hero />
    <Benefits />
    <HowItWork />
    <Features />
    <Cta />
  </Main>
</Layout>
