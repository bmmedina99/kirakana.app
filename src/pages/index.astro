---
import Cta from '@/components/landing/Cta.astro'
import Faq from '@/components/landing/Faq.astro'
import Hero from '@/components/landing/Hero.astro'
import HowItWorks from '@/components/landing/HowItWorks.astro'
import TargetAudience from '@/components/landing/TargetAudience.astro'
import WhyKirakana from '@/components/landing/WhyKiraKana.astro'
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
import { homepageSchema } from '@/lib/schema'
import { configSite } from '@/lib/site.config'

const title = 'Aprende Hiragana y Katakana gratis desde cero'
const description = configSite.description
const canonical = configSite.url
const schemas = homepageSchema({ url: canonical, title, description })
---

<Layout {title} {description} {canonical} {schemas} breadcrumbs={false}>
  <Main>
    <Hero />
    <HowItWorks />
    <TargetAudience />
    <WhyKirakana />
    <Faq />
    <Cta />
  </Main>
</Layout>
