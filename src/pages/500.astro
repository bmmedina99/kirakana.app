---
import Main from '@/components/layout/Main.astro'
import KanaPreview from '@/components/sections/KanaPreview.astro'
import Icon from '@/components/ui/Icon.astro'
import Layout from '@/layouts/Layout.astro'

const { error } = Astro.props
---

<Layout
  title="Error del servidor"
  description="Estamos trabajando para solucionarlo lo más pronto posible. Mientras tanto, puedes volver a intentarlo."
  robots="noindex, follow"
  errorPage
>
  <Main class="pt-16">
    <section class="flex flex-col px-8">
      <div
        class="container grid items-center w-full grid-cols-1 gap-16 mx-auto lg:grid-cols-2"
      >
        <div class="flex flex-col justify-center space-y-4">
          <p
            class="flex items-center gap-2 text-sm font-semibold font-japanese text-copper-100"
            aria-hidden="true"
          >
            <Icon name="cherry" class="text-ochre-100 size-4" />
            <span>キラカナ</span>
          </p>
          <h1 class="font-semibold leading-tight tracking-tight text-balance">
            Ha ocurrido un problema
            <span class="block text-lg tracking-normal text-copper-100">
              問題が発生しました
            </span>
          </h1>
          <div class="max-w-xl md:text-xl text-pretty text-copper-100">
            <p>
              Estamos trabajando para solucionarlo lo más pronto posible.
              Mientras tanto, puedes volver a intentarlo.
            </p>
            {
              process.env.NODE_ENV === "development" && (
                <details class="p-4 mt-4 border rounded-lg border-ochre-200 bg-linen-200 text-ochre-100">
                  <summary class="font-semibold cursor-pointer">
                    Mensaje de error
                  </summary>
                  <pre class="mt-2 text-sm whitespace-pre-line">
                    {error.message}
                  </pre>
                </details>
              )
            }
          </div>
          <nav class="flex flex-wrap gap-4" aria-label="Acciones">
            <button
              type="button"
              onclick="window.history.back()"
              title="Volver a practicar"
              class="transition-all shadow-lg cursor-default btn bg-linear-to-r from-ochre-200 to-ochre-100 text-mauve-50 hover:scale-95"
              aria-label="Volver a practicar"
            >
              <Icon name="backpage" />
              <span>Volver a practicar</span>
            </button>
            <button
              type="button"
              onclick="window.location.reload()"
              title="Recargar página"
              class="border-2 shadow-lg cursor-default btn bg-linen-200 border-cyan-700 text-copper-100 hover:scale-95"
              aria-label="Recargar página"
            >
              <span>Recargar página</span>
            </button>
          </nav>
        </div>
        <KanaPreview />
      </div>
    </section>
  </Main>
</Layout>
