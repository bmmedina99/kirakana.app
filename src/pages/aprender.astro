---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
import { Hiragana, Katakana } from '@/site.config'
---

<Layout title="Aprender silabarios" description="Aprende los silabarios japoneses para poner a prueba tus conocimientos en práctica">
  <Main class="flex items-center justify-center m-4">
    <section>
      <h1 class="font-bold font-heading text-balance">Aprende los silabarios japoneses</h1>
      <p class="text-pretty md:text-xl">Aprende los silabarios japoneses para poner a prueba tus conocimientos en práctica.</p>
      <h2 class="my-4 text-4xl font-bold font-heading">Hiragana</h2>
      <div class="grid max-w-xl grid-cols-3 mx-auto gap-y-4 md:grid-cols-4 lg:grid-cols-6 place-items-center">
        {Hiragana.map((char) => (
          <div class="flex flex-col items-center justify-center text-center bg-yellow-100 rounded-lg size-16">
            <h3 class="text-xl font-semibold font-heading">{char.kana}</h3>
            <p class="text-lg">{char.romanji}</p>
          </div>
        ))}
      </div>
      <h2 class="my-4 text-4xl font-bold font-heading">Katakana</h2>
      <div class="grid max-w-xl grid-cols-3 mx-auto gap-y-4 md:grid-cols-4 lg:grid-cols-6 place-items-center">
        {Katakana.map((char) => (
          <div class="flex flex-col items-center justify-center text-center bg-yellow-100 rounded-lg size-16">
            <h3 class="text-xl font-semibold font-heading">{char.kana}</h3>
            <p class="text-lg">{char.romanji}</p>
          </div>
        ))}
      </div>
    </section>
  </Main>
</Layout>
