---
import Main from '@/components/layout/Main.astro'
import Icon from '@/components/ui/Icon.astro'
import Layout from '@/layouts/Layout.astro'

const learnCards = [
  {
    japanese: 'ひらがな',
    title: 'Hiragana',
    description:
      'El silabario básico que representa los sonidos nativos del japonés.',
    icon: 'hiragana',
    color: 'ochre-200',
    characters: [
      { char: 'あ', romaji: 'a' },
      { char: 'い', romaji: 'i' },
      { char: 'う', romaji: 'u' },
      { char: 'え', romaji: 'e' },
      { char: 'お', romaji: 'o' },
    ],
    buttonText: 'Aprender hiragana',
  },
  {
    japanese: 'カタカナ',
    title: 'Katakana',
    description:
      'El silabario utilizado para palabras extranjeras y onomatopeyas.',
    icon: 'katakana',
    color: 'cyan-900',
    characters: [
      { char: 'ア', romaji: 'a' },
      { char: 'イ', romaji: 'i' },
      { char: 'ウ', romaji: 'u' },
      { char: 'エ', romaji: 'e' },
      { char: 'オ', romaji: 'o' },
    ],
    buttonText: 'Aprender katakana',
  },
]
---

<Layout
  title="Aprender japonés"
  description="Aprende los silabarios japoneses, hiragana y katakana para poner a prueba tus conocimientos en práctica"
>
  <Main>
    <section class="container px-4 pb-8 mx-auto">
      <div class="max-w-2xl mb-4 space-y-2 leading-relaxed">
        <h1 class="font-semibold leading-tight tracking-tight text-balance">
          Aprende los silabarios <span class="text-ochre-200">japoneses</span>
        </h1>
        <p class="max-w-xl md:text-xl text-pretty text-copper-100">
          Elige qué silabario quieres aprende y haz un seguimineento de tu
          progreso en el camino del aprendizaje del japonés.
        </p>
      </div>
      <div class="grid items-start grid-cols-1 gap-12 lg:grid-cols-2">
        {
          learnCards.map((card) => (
            <div class="shadow-xl group bg-mauve-50 rounded-2xl">
              <div class="p-10 lg:p-14">
                <div class="flex items-start justify-between mb-12">
                  <div>
                    <span class={`text-${card.color} text-2xl`}>
                      {card.japanese}
                    </span>
                    <h2 class="mb-2 text-4xl text-semibold">{card.title}</h2>
                    <p class="text-lg md:text-xl text-copper-100 text-pretty">
                      {card.description}
                    </p>
                  </div>
                  <div
                    class={`bg-${card.color} flex items-center justify-center rounded-full size-16 text-mauve-50`}
                  >
                    <Icon name={card.icon} class="size-8" />
                  </div>
                </div>
                <div class="flex items-center justify-between py-4 mb-10 overflow-hidden select-none">
                  {card.characters.map((char) => (
                    <div class="flex flex-col items-center">
                      <span
                        class={`text-${card.color} mb-2 text-4xl transition-transform duration-300 font-japanese group-hover:scale-110`}
                      >
                        {char.char}
                      </span>
                      <span class="text-sm">{char.romaji}</span>
                    </div>
                  ))}
                </div>
                <button
                  class={`bg-${card.color} btn w-full tracking-widest uppercase hover:bg-primary transition-all duration-300 shadow-lg shadow-${card.color} active:shadow-transparent active:scale-95 text-mauve-50`}
                >
                  {card.buttonText}
                </button>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </Main>
</Layout>
