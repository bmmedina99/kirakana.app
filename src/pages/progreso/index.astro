---
import Main from '@/components/layout/Main.astro'
import ProgressDashboard from '@/features/progress/islands/ProgressDashboard'
import Layout from '@/layouts/Layout.astro'
import { progressSchema } from '@/lib/schema'
import { configSite } from '@/lib/site.config'

const title = 'Tu progreso aprendiendo japonés'
const description =
  'Visualiza tu progreso aprendiendo japonés: consultas, dominio estimado en reconocimiento, kana para repasar y racha diaria. Guardado localmente, sin cuenta ni suscripción necesaria.'
const canonical = `${configSite.url}/progreso`
const schemas = progressSchema({ url: canonical, title, description })
---

<Layout {title} {description} {canonical} {schemas}>
  <Main>
    <ProgressDashboard client:only="react" />
  </Main>
</Layout>
