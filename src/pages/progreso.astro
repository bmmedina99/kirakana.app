---
import Main from '@/components/layout/Main.astro'
import ScorePuzzle from '@/components/puzzle/Score'
import Layout from '@/layouts/Layout.astro'
---

<Layout
  title="Progreso"
  description="Realiza un seguimiento de tu progreso y mira hasta dónde has llegado"
>
  <Main class="flex items-center justify-center grow">
    <section>
      <h1 class="font-bold font-heading text-balance">Tu progreso</h1>
      <p class="mb-4 text-pretty md:text-xl">
        Realiza un seguimiento de tu progreso y mira hasta dónde has llegado.
      </p>
      <div
        class="p-4 bg-yellow-100 border border-yellow-400 rounded-lg text-neutral-800"
      >
        <div class="mb-4">
          <h3 class="text-lg font-semibold font-heading">Puntaje recientes</h3>
          <p class="text-sm">Los últimos 5 puntajes entre Hiragana y Katakana.</p>
        </div>
        <ScorePuzzle client:idle />
      </div>
      <div class="flex justify-center">
        <button
          type="button"
          class="px-4 py-2 mt-4 transition-colors bg-red-700 rounded hover:bg-red-400 text-neutral-100"
          onclick="localStorage.clear(); location.reload();"
        >
          Borrar historial
        </button>
      </div>
    </section>
  </Main>
</Layout>
