---
import Main from '@/components/layout/Main.astro'
import PracticeLanding from '@/features/practice/components/PracticeLanding.astro'
import Layout from '@/layouts/Layout.astro'

const practiceTitle = 'Practica el silabario japonés: Hiragana y Katakana'
const practiceDescription =
  'Practica hiragana y katakana con ejercicios interactivos. Reconocimiento visual, feedback inmediato y sin límite de intentos. ¡Empieza gratis!'
---

