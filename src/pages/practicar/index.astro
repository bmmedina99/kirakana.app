---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout
  title="Practicar"
  description="Elige un modo de práctica para reforzar tus conocimientos sobre los caracteres japoneses"
>
  <Main class="flex items-center justify-center grow">
    <section class="max-w-xl py-8 mx-auto space-y-6 text-center">
      <h1 class="text-2xl font-bold font-heading">Elige un silabario</h1>
      <div class="grid grid-cols-2 gap-4">
        <a
          href="/practicar/hiragana"
          class="px-4 py-6 transition-colors border border-red-700 rounded-lg hover:bg-red-400"
        >
          Hiragana
        </a>
        <a
          href="/practicar/katakana"
          class="px-4 py-6 transition-colors border rounded-lg border-cyan-700 hover:bg-sky-400"
        >
          Katakana
        </a>
      </div>
    </section>
  </Main>
</Layout>
