---
import Main from '@/components/layout/Main.astro'
import KanaCard from '@/components/ui/KanaCard.astro'
import Section from '@/components/ui/Section.astro'
import Layout from '@/layouts/Layout.astro'

const practiceCards = [
  {
    japanese: 'ひらがな',
    title: 'Hiragana',
    description:
      'El silabario básico que representa los sonidos nativos del japonés.',
    icon: 'hiragana',
    color: 'ochre-200',
    characters: [
      { char: 'あ', romaji: 'a' },
      { char: 'い', romaji: 'i' },
      { char: 'う', romaji: 'u' },
      { char: 'え', romaji: 'e' },
      { char: 'お', romaji: 'o' },
    ],
    href: '/practicar/hiragana/',
    buttonText: 'Practicar hiragana',
    buttonShadow: 'shadow-ochre-200',
  },
  {
    japanese: 'カタカナ',
    title: 'Katakana',
    description:
      'El silabario utilizado para palabras extranjeras y onomatopeyas.',
    icon: 'katakana',
    color: 'cyan-900',
    characters: [
      { char: 'ア', romaji: 'a' },
      { char: 'イ', romaji: 'i' },
      { char: 'ウ', romaji: 'u' },
      { char: 'エ', romaji: 'e' },
      { char: 'オ', romaji: 'o' },
    ],
    href: '/practicar/katakana/',
    buttonText: 'Practicar katakana',
    buttonShadow: 'shadow-cyan-900',
  },
]
---

<Layout
  title="Practica el silabario japonés: Hiragana y Katakana"
  description="Practica hiragana y katakana con ejercicios interactivos. Reconocimiento visual, feedback inmediato y sin límite de intentos. ¡Empieza gratis!"
>
  <Main>
    <Section>
      <Fragment slot="title">
        Practica con ejercicios <span class="text-ochre-200">interactivos</span>
      </Fragment>
      <Fragment slot="description">
        Practica <span class="font-semibold text-ochre-200">hiragana</span>
        y <span class="font-semibold text-cyan-900">katakana</span> poniendo a prueba
        tu reconocimiento visual y auditivo de los kana japoneses con ejercicios interactivos. Sin límite de intentos.
      </Fragment>
      <ul class="grid items-start grid-cols-1 gap-12 lg:grid-cols-2">
        {
          practiceCards.map((card) => (
            <li>
              <KanaCard {...card} />
            </li>
          ))
        }
      </ul>
    </Section>
  </Main>
</Layout>
