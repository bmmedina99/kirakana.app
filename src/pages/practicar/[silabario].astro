---
import Main from '@/components/layout/Main.astro'
import Game from '@/components/puzzle/Game'
import Layout from '@/layouts/Layout.astro'
import type { Syllabarys } from '@/types'

export async function getStaticPaths() {
  return [
    { params: { silabario: 'hiragana' } },
    { params: { silabario: 'katakana' } },
  ]
}

const { silabario } = Astro.params
---

<Layout
  title={`Practicar ${silabario}`}
  description={`Modo de práctica para reforzar tus conocimientos sobre los caracteres japoneses del silabario ${silabario}`}
>
  <Main>
    <Game syllabary={silabario as Syllabarys} client:idle />
  </Main>
</Layout>
