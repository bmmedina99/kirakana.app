---
import Main from '@/components/layout/Main.astro'
import { syllabaries } from '@/features/data/syllabaries'
import PracticePage from '@/features/practice/components/PracticePage.astro'
import { practiceModes } from '@/features/practice/modes'
import Layout from '@/layouts/Layout.astro'
import { practiceSessionSchema } from '@/lib/schema'
import { configSite } from '@/lib/site.config'

export function getStaticPaths() {
  return practiceModes.flatMap((mode) =>
    syllabaries
      .filter((syllabary) => mode.supportedSyllabaries.includes(syllabary.slug))
      .map((syllabary) => ({
        params: {
          mode: mode.slug,
          syllabary: syllabary.slug,
        },
        props: {
          mode,
          syllabary,
        },
      })),
  )
}

const { mode, syllabary } = Astro.props
const title = `${mode.name} de ${syllabary.name}`
const description = `${mode.description} Practica ${syllabary.name} de forma interactiva en KiraKana.`
const canonical = `${configSite.url}/practicar/${mode.slug}/${syllabary.slug}`
const schemas = practiceSessionSchema({
  mode: mode.slug,
  syllabary: syllabary.slug,
  url: canonical,
  title,
  description,
})
---

<Layout {title} {description} {canonical} {schemas}>
  <Main>
    <PracticePage mode={mode} syllabary={syllabary} />
  </Main>
</Layout>
