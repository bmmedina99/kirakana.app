---
import Main from '@/components/layout/Main.astro'
import { syllabaries } from '@/features/data/syllabaries'
import PracticePage from '@/features/practice/components/PracticePage.astro'
import { practiceModes } from '@/features/practice/modes'
import Layout from '@/layouts/Layout.astro'

export function getStaticPaths() {
  return practiceModes.flatMap((mode) =>
    syllabaries
      .filter((syllabary) => mode.supportedSyllabaries.includes(syllabary.slug))
      .map((syllabary) => ({
        params: {
          mode: mode.slug,
          syllabary: syllabary.slug,
        },
        props: {
          mode,
          syllabary,
        },
      })),
  )
}

const { mode, syllabary } = Astro.props

// const pagePath = routes.practice.modeSyllabary(mode.slug, syllabary.slug)
// const pageUrl = `${SITE_URL}${pagePath}`

const PracticeModeSyllabaryTitle = `${mode.name} de ${syllabary.name}`
const PracticeModeSyllabaryDescription = `${mode.description} Practica ${syllabary.name} de forma interactiva en KiraKana.`
---

<Layout
  title={PracticeModeSyllabaryTitle}
  description={PracticeModeSyllabaryDescription}
>
  <Main>
    <PracticePage mode={mode} syllabary={syllabary} />
  </Main>
</Layout>
