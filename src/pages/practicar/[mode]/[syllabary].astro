---
import Main from '@/components/layout/Main.astro'
import Game from '@/components/puzzle/Game'
import Layout from '@/layouts/Layout.astro'
import type { SyllabarySlug } from '@/lib/routes'

export async function getStaticPaths() {
  const syllabaries: SyllabarySlug[] = ['hiragana', 'katakana']
  return syllabaries.map((syllabary) => ({ params: { syllabary } }))
}

const { syllabary } = Astro.params
---

<Layout
  title={`Practicar ${syllabary}`}
  description={`Modo de práctica para reforzar tus conocimientos sobre los caracteres japoneses del silabario ${syllabary}`}
>
  <Main>
    <Game syllabary={syllabary as SyllabarySlug} client:idle />
  </Main>
</Layout>
