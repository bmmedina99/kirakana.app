---
import Main from '@/components/layout/Main.astro'
import PracticeModeLanding from '@/features/practice/components/PracticeModeLanding.astro'
import { practiceModes } from '@/features/practice/modes'
import Layout from '@/layouts/Layout.astro'

export function getStaticPaths() {
  return practiceModes.map((mode) => ({
    params: {
      mode: mode.slug,
    },
    props: {
      mode,
    },
  }))
}

const { mode } = Astro.props

// const pagePath = routes.practice.mode(mode.slug)
// const pageUrl = `${SITE_URL}${pagePath}`

const practiceModeTitle = `Practicar ${mode.name.toLowerCase()} de los silabarios japoneses`
const practiceModeDescription = mode.longDescription
---

<Layout title={practiceModeTitle} description={practiceModeDescription}>
  <Main class="container mx-auto">
    <PracticeModeLanding mode={mode} />
  </Main>
</Layout>
