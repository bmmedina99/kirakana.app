---
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import Meta from '../components/Meta.astro'
import { configSite } from '../site.config'

const { ...meta } = Astro.props
---

<!doctype html>
<html lang={configSite.lang}>
  <head>
    <Meta {...meta} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">Ir al contenido principal</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 3rem;
  }
  body {
    display: flex;
    flex-direction: column;
    background-color: oklch(98.7% 0.022 95.277);
    min-height: 100dvh;
    font-family: "Noto Sans JP", sans-serif;
    color: oklch(26.9% 0 0);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  section h1 {
    font-size: clamp(3rem, 8vw, 4.5rem);
    transition: font-family 0.15s ease-out;
  }
</style>
