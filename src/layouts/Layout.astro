---
import Footer from '@/components/layout/Footer.astro'
import Header from '@/components/layout/Header.astro'
import type { BreadcrumbItem, SchemaBase } from '@/lib/schema'
import { configSite } from '@/lib/site.config'
import Meta from '../components/Meta.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  schemas?: SchemaBase[]
  breadcrumbs?: BreadcrumbItem[] | false
  ogImage?: string
  noindex?: boolean
}

const { ...meta } = Astro.props
---

<!doctype html>
<html lang={configSite.lang}>
  <head>
    <Meta {...meta} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">
      Ir al contenido principal
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
