---
import Meta from '../components/Meta.astro'
import { configSite } from '../site.config'

const { ...meta } = Astro.props
---

<!doctype html>
<html lang={configSite.lang}>
  <head>
    <Meta {...meta} />
  </head>
  <body class="grid min-h-dvh antialiased font-body bg-amber-50 text-neutral-800">
    <slot />
  </body>
</html>
