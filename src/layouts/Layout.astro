---
import Meta from '../components/Meta.astro'
import { configSite } from '../site.config'

const { ...meta } = Astro.props
---

<!doctype html>
<html lang={configSite.lang}>
  <head>
    <Meta {...meta} />
  </head>
  <body class="grid min-h-screen antialiased font-body bg-gradient-to-br from-slate-800 via-purple-800 to-slate-800">
    <slot />
  </body>
</html>
