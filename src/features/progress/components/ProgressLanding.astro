---
import Section from '@/components/layout/Section.astro'
---

<Section labelledby="progress-heading">
  <Fragment slot="title">
    Tu progreso aprendiendo <span class="text-ochre-200">japonés</span>
  </Fragment>
  <Fragment slot="description">
    Aquí puedes ver tu avance aprendiendo
    <span class="text-ochre-200"> hiragana </span>
    y <span class="text-cyan-900">katakana</span>. Tu progreso se guarda
    localmente en tu navegador, sin necesidad de cuenta ni registro.
  </Fragment>
  <div class="p-6 bg-linen-50 border border-sun-100 rounded-xl shadow-sm">
    <div class="mb-4">
      <h3 class="text-xl font-semibold">Puntaje recientes</h3>
      <p>Los últimos 5 puntajes entre Hiragana y Katakana.</p>
    </div>
    <!-- <ProgressDasboard client:idle /> -->
  </div>
  <div class="flex items-center justify-center mt-4 gap-4">
    <button
      id="clear-progress"
      type="button"
      class="shadow-lg cursor-default btn bg-ochre-200 text-mauve-50 hover:scale-95"
      aria-describedby="clear-progress-status"
    >
      Borrar historial
    </button>
  </div>
  <p
    id="clear-progress-status"
    role="status"
    class="mt-4 text-center text-sm text-copper-200"
  ></p>
</Section>

<script>
  import { clearStoredProgress } from '@/features/progress/utils/storage'

  const button = document.querySelector<HTMLButtonElement>('#clear-progress')
  const status = document.querySelector<HTMLParagraphElement>(
    '#clear-progress-status',
  )

  button?.addEventListener('click', async () => {
    if (
      !window.confirm(
        '¿Quieres borrar tu historial de KiraKana? Esta acción no se puede deshacer.',
      )
    ) return

    button.disabled = true
    const result = await clearStoredProgress()
    if (status) {
      status.textContent = result.ok
        ? 'Se ha borrado el historial de KiraKana.'
        : 'No se ha podido borrar el historial. Comprueba que el navegador permite acceder a los datos del sitio.'
    }
    button.disabled = false
  })
</script>
