---
import Section from '@/components/layout/Section.astro'
import { practiceModes } from '../modes'
import PracticeModeCard from './PracticeModeCard.astro'
---

<Section labelledby="practice-heading">
  <Fragment slot="title">
    Practica con ejercicios <span class="text-ochre-200">interactivos</span>
  </Fragment>
  <Fragment slot="description">
    Practica <span class="text-ochre-200"> hiragana </span>
    y <span class="text-cyan-900">katakana</span> poniendo a prueba tu reconocimiento
    visual y auditivo de los kana japoneses con ejercicios interactivos. Sin límite
    de intentos.
  </Fragment>
  <div class="grid gap-6 lg:grid-cols-3 [&>article]:col-start-2">
    {practiceModes.map((mode) => <PracticeModeCard mode={mode} />)}
  </div>
</Section>
