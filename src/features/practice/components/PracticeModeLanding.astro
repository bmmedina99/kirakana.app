---
import Section from '@/components/layout/Section.astro'
import SyllabarySelectionGrid from '@/components/ui/SyllabarySelectionGrid.astro'
import type { PracticeMode } from '@/features/practice/modes'
import { routes } from '@/lib/routes'

type Props = {
  mode: PracticeMode
}

const { mode } = Astro.props
---

<Section labelledby="practice-mode-heading">
  <Fragment slot="title">
    Practicar {mode.name.toLowerCase()}
  </Fragment>
  <Fragment slot="description">
    {mode.longDescription}
  </Fragment>
  <SyllabarySelectionGrid
    getHref={(slug) => routes.practice.modeSyllabary(mode.slug, slug)}
    getButtonLabel={(name) => `Practicar ${name}`}
  />
</Section>

