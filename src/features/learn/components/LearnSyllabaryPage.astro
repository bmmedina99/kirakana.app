---
import type { Syllabary } from '@/features/data/syllabaries'
import { routes } from '@/lib/routes'
import LearnSyllabaryExperience from '../islands/LearnSyllabaryExperience'

type Props = {
  syllabary: Syllabary
}

const { syllabary } = Astro.props
const practiceHref = routes.practice.modeSyllabary(
  'reconocimiento',
  syllabary.slug,
)
---

<LearnSyllabaryExperience client:load {syllabary} {practiceHref} />
