{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "isolatedModules": true,
    "jsx": "preserve", // cambiar a "react-jsx" si usas React
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["node_modules", "dist"]
}
